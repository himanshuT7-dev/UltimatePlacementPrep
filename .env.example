# Server-side environment variables for the Ultimate Placement Preparation app.
# These are read by the Vercel serverless API routes (api/) and the local
# admin CMS server (admin-server.js). Copy this file to .env and fill in values.

# Google Gemini API key. Used by the /api/gemini AI proxy (primary provider).
GEMINI_API_KEY=

# Groq API key. Used as a fallback AI provider in /api/gemini.
GROQ_API_KEY=

# Secret used to sign and verify JWT auth tokens. REQUIRED in production;
# /api/auth routes will fail fast if this is missing.
JWT_SECRET=

# Admin token protecting the local CMS save endpoint in admin-server.js.
ADMIN_TOKEN=

# MongoDB connection string. Required for auth and progress features.
# Leave commented/empty if not using the database features.
MONGODB_URI=
